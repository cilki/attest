#!/usr/bin/env bash

#attest(2ms < cpu < 10ms)
testHelp() {
	md5sum --help
}

# attest(
#   wall < 1s,
#   pids <= 3,
# )
testVersion() {
	md5sum --version
}

## Known input, known output.
# attest(mem < 20MiB)
testHello() {
	result=$(echo hello | md5sum)

	[ "${result}" = "b1946ac92492d2347c6235b4d2611184  -" ]
}
